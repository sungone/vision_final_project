FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_UPLOAD_REQUEST_BYTES=11534336

DATABASE_URL=postgresql+psycopg://vision:vision@localhost:5432/vision_inspection
DATABASE_AUTO_CREATE=false

# USB/UVC 카메라가 운영체제에 등록된 인덱스
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_RECONNECT_SECONDS=2.0

VISION_FPS=10
VISION_LIVE_CONSOLE=false
VISION_CONSOLE_REFRESH_FPS=4
STREAM_FPS=10
JPEG_QUALITY=80

VISION_PROCESSOR=unet
UNET_FINE_MODEL_PATH=../output/u-net/fine/best.pt
UNET_LOCATOR_MODEL_PATH=../output/u-net/locator/best.pt
UNET_LOCATOR_WIDTH=512
UNET_FINE_SIZE=512
UNET_ROI_MARGIN=1.3
UNET_ROI_MIN_SIDE=256
UNET_ROI_SMOOTH=0.5
UNET_USE_LOCATOR=true
UNET_MIN_COMPONENT_AREA=150
UNET_USE_HALF=true

# yolo26 선택 시 사용하는 기존 모델 설정
YOLO26_MODEL_PATH=../output/yolo26/best.pt
YOLO_IMAGE_SIZE=640
YOLO_SCORE_THRESHOLD=0.70
YOLO_IOU_THRESHOLD=0.70
YOLO_MAX_DETECTIONS=100
YOLO_USE_HALF=true

# mask_rcnn 선택 시 사용하는 기존 모델 설정
MASK_RCNN_MODEL_PATH=../output/mask_rcnn/mask_rcnn_state_dict.pt
MASK_RCNN_METADATA_PATH=../output/mask_rcnn/model_metadata.json
VISION_DEVICE=auto
MASK_SCORE_THRESHOLD=0.70
MASK_BINARY_THRESHOLD=0.50
MASK_OVERLAY_ALPHA=0.45
DRAW_BOUNDING_BOXES=true
DRAW_INFERENCE_STATS=true

# 체결 의사결정 기준. 아래 환경변수를 명시하면 thresholds.json보다 우선한다.
EXPECTED_WASHER_COUNT=2
DECISION_THRESHOLDS_PATH=../U-NET/U-NET/thresholds.json
THREAD_EXPOSURE_MIN_RATIO=1.30 ## 나사산 임계값
NUT_WASHER_GAP_MAX_RATIO=
# BOLT_DIAMETER_MM=

# DB event 평가는 Vision FPS와 독립적으로 기본 초당 1회 수행
EVENT_SAMPLE_FPS=1.0
# 정규화된 기하 feature 허용 오차 시작값. 실제 파일럿 데이터로 보정
DEFECT_GEOMETRY_TOLERANCE_RATIO=0.05
# sampled NORMAL 횟수. 1 FPS에서 5이면 약 5초 후 이전 signature reset
NORMAL_RESET_FRAMES=5
PERSISTENCE_QUEUE_SIZE=10
PERSISTENCE_RETRY_SECONDS=2.0
ALLOW_MOCK_FALLBACK=false

DEFECT_STORAGE_DIR=storage/defects
START_BACKGROUND_WORKERS=true


