FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://vision:vision@localhost:5432/vision
DATABASE_AUTO_CREATE=false

# USB/UVC 카메라가 운영체제에 등록된 인덱스
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_RECONNECT_SECONDS=2.0

VISION_FPS=10
STREAM_FPS=10
JPEG_QUALITY=80

VISION_PROCESSOR=yolo26
YOLO26_MODEL_PATH=../output/yolo26/best.pt
YOLO_IMAGE_SIZE=640
YOLO_SCORE_THRESHOLD=0.70
YOLO_IOU_THRESHOLD=0.70
YOLO_MAX_DETECTIONS=100
YOLO_USE_HALF=true

# mask_rcnn 선택 시 사용하는 기존 모델 설정
MASK_RCNN_MODEL_PATH=../output/mask_rcnn/mask_rcnn_state_dict.pt
MASK_RCNN_METADATA_PATH=../output/mask_rcnn/model_metadata.json
VISION_DEVICE=auto
MASK_SCORE_THRESHOLD=0.70
MASK_BINARY_THRESHOLD=0.50
MASK_OVERLAY_ALPHA=0.45
DRAW_BOUNDING_BOXES=true
DRAW_INFERENCE_STATS=true

DEFECT_CONFIRM_FRAMES=3
NORMAL_RESET_FRAMES=5
EVENT_COOLDOWN_SECONDS=1.0

DEFECT_STORAGE_DIR=storage/defects
START_BACKGROUND_WORKERS=true


